# -*- coding: utf-8 -*-
"""FreeCAD macro: ComLang haptic palm-writing box v2 (prototype CAD), parametric. Flat version (20 mm).

The hand lies PALM DOWN in a shallow glove-shaped recess on the box top. Under the palm is a
window closed by a replaceable cover membrane; a pointed pen on a flat CoreXY gantry (two flat
gimbal motors, belts in two flat layers) presses up through the membrane and traces block
capitals on the palm. A thumb scroll roller (roll = speed, press = pause) and a Repeat button by
the little finger, a Mode button for the free hand, all with raised tactile symbols. Pop-out
Braille pins (latching actuators) under the index and middle fingertips; a display and Reset
button for the speaker at the rear. The box is 20 mm tall.

GUI:       freecad haptic_box_v2.FCMacro   (animates the gantry writing TEXT;
           stop with stop_writer() in the Python console)
Headless:  freecadcmd haptic_box_v2.FCMacro
           -> clearance checks, saves haptic_box_v2.FCStd + haptic_box_v2.step
           HAPTIC_DUMP=build/v2_mesh.json also writes meshes for render_views.py

Frame: x across (+x = user's right), y away from the user (y=0 = front face),
z up from the table. Units mm. Needs comlang/ (engine) and hand_model.py in the same folder.
"""
import json, math, os, sys, time
import FreeCAD as App
import Part
from FreeCAD import Vector, Placement, Rotation

# ---------------- parameters ----------------
HAND = "right"                 # "right" / "left": mirrors thumb side, buttons and Braille cells
BOX_W, BOX_L = 260.0, 380.0   # outside footprint (rear 70 mm = speaker strip: display, Reset, mic)
WALL, FLOOR = 2.0, 1.5         # walls; aluminium base sheet (also the motor heat sink)
PLATE_UNDER = 15.0             # underside of the top plate: the whole mechanism lives in 1.5..15
BASE_T = 2.5                   # lower top-plate layer (aluminium): the floor the hand rests on
RECESS = 2.5                   # depth of the glove-shaped recess = thickness of the upper layer
TOP_T = BASE_T + RECESS        # whole top plate
PALM_Z = PLATE_UNDER + BASE_T  # palm skin height (rests on the recess floor / cover) = 17.5
BOX_H = PALM_Z + RECESS        # top surface height = 20
EDGE_R = 1.2                   # rounded top edge of the recess
CORNER_R = 12.0
WRIST_Y = 100.0                # wrist crease position
PALM_Y = WRIST_Y + 55.0        # centre of the writing area
WRIST_CHANNEL_W = 80.0         # the recess opens to the front edge so the forearm lies level
WINDOW, WINDOW_R = 84.0, 8.0   # opening under the palm (70 mm workspace + pen + margin)
GLOVE_MARGIN = 5.0             # glove print: room around the hull of all hand sizes
# protective cover between pen and palm: a membrane stretched on a drop-in cassette frame
COVER, COVER_R = 100.0, 10.0   # cassette outside (sits in a pocket in the floor layer)
COVER_FRAME_T = 1.2            # frame thickness (stainless); membrane on top
COVER_T = 0.3                  # membrane thickness (material under test, §10 T13)
PEN_PRESS = 1.5                # how far the tip pushes above the floor (membrane + skin indentation)
PEN_UP_GAP = 1.0               # retracted tip sits this far below the plate underside
# gantry: CoreXY. Two flat gimbal BLDC motors drive two GT2 3 mm belts running FLAT in two
# layers; the gantry (two Y-blocks + twin X-rods) slides on the Y-rods, the carriage on the X-rods.
ROD_R = 2.5                    # Y-rods and X-rods D5 (iglidur J bushings, 7 mm OD)
BORE = 3.5                     # bushing housing radius
RAIL_X = 108.0                 # Y-rods at x = +-RAIL_X
Z_YROD, Z_XROD = 7.0, 10.5     # rod heights
XROD_DY = 7.0                  # twin X-rods at gantry y +- XROD_DY
ROD_Y0, ROD_Y1 = PALM_Y - 60.0, PALM_Y + 60.0     # Y-rod supports
BELT_W = 3.0                   # GT2 3 mm belt (width is vertical: belts run flat)
BELT_A_Z, BELT_B_Z = 2.0, 5.5  # bottom of belt A (lower) / belt B (upper)
BELT_X = 98.0                  # belt runs along y at x = +-BELT_X
IDLER_R = 5.0                  # GT2 16T idler (pitch r ~5)
IDLER_DY = 16.0                # gantry idlers at gantry y -+ IDLER_DY (A front, B rear)
RING_R = 15.9                  # GT2 50T ring pulley on each motor rotor (pitch radius)
MOTOR_R, MOTOR_H = 14.0, 10.5  # flat gimbal BLDC (2804 class), can D28 x 10.5 on the base
PEN_DX, PEN_DY = 0.0, 0.0      # pen at the carriage centre, between the twin X-rods
TEXT = "HELLO"                 # GUI animation
# --------------------------------------------

try:
    HERE = os.path.dirname(os.path.abspath(__file__))
except NameError:
    HERE = os.getcwd()
sys.path.insert(0, HERE)
from comlang import engine as pw  # noqa: E402

TS = -1.0 if HAND == "right" else 1.0   # thumb side: palm down, a right thumb points to -x
PEN_UP_TIP = PLATE_UNDER - PEN_UP_GAP
PEN_DOWN_TIP = PALM_Z + PEN_PRESS
GC_MIN, GC_MAX = PALM_Y - pw.WORKSPACE / 2, PALM_Y + pw.WORKSPACE / 2   # gantry centre travel
MOTOR_A = (-BELT_X + RING_R, ROD_Y1 + 23.0)     # rear-left, belt A (lower layer)
MOTOR_B = (BELT_X - RING_R, ROD_Y0 - 23.0)      # front-right, belt B (upper layer)
IDLER_A = (BELT_X - IDLER_R, MOTOR_A[1] + RING_R - IDLER_R)    # rear-right corner idler, belt A
IDLER_B = (-BELT_X + IDLER_R, MOTOR_B[1] - RING_R + IDLER_R)   # front-left corner idler, belt B
import hand_model as HM  # noqa: E402

HANDS = {s: HM.Hand(s, WRIST_Y, PALM_Z, TS) for s in HM.SIZES}   # small / medium / large
MED = HANDS["medium"]
CAP_TOP = PALM_Z + 2.5          # Repeat cap top flush with the top surface (2.5 above the recess floor)
WHEEL_R, WHEEL_W, WHEEL_UP = 3.0, 10.0, 2.5   # thumb scroll roller: D6 x 10, crown 2.5 above the floor
WELL_CLEAR = 3.5                # clearance around each digit's path to its button
BUTTONS = HM.place_buttons(WRIST_Y, PALM_Z, TS, CAP_TOP)        # resting hand: Wheel, Repeat
BUTTONS["Wheel"]["top"] = PALM_Z + WHEEL_UP
WHEEL = BUTTONS["Wheel"]
WHEEL_AX = (-WHEEL["roll"][1], WHEEL["roll"][0])                 # wheel axle direction (plan)
# free-hand strip (front corner on the thumb side, where the other hand rests): rare actions
STRIP = {"Mode": dict(x=TS * 93.0, y=42.0, r=12.0, symbol="mode")}
SYMBOL_RELIEF = "raised"        # "raised" (embossed, as in the pitch) or "etched" (incised)
# speaker strip at the rear: display (text rotated to face the speaker) + Reset
DISPLAY = dict(x=-TS * -25.0, y=340.0, w=85.0, l=55.0, t=6.0, view_w=77.0, view_l=52.0)
SPEAKER = {"Reset": dict(x=-TS * 45.0, y=340.0, r=10.0, symbol="reset")}
POCKET_D, POCKET_CLEAR = 3.0, 2.5   # strip buttons sit in pockets, cap top 1 mm below the surface


def _pad(h, digit, back=3.0):
    """Fingertip pad centre (plan view) of a resting digit."""
    pts, r, d = h.rest()[digit]
    return (pts[3][0] - d[0] * back, pts[3][1] - d[1] * back)


BRAILLE_CELLS = [("index", _pad(MED, "index")), ("middle", _pad(MED, "middle"))]


def V(x, y, z=0.0):
    return Vector(x, y, z)


def rbox(w, l, h, r, x, y, z):
    b = Part.makeBox(w, l, h, V(x, y, z))
    if r <= 0:
        return b
    return b.makeFillet(r, [e for e in b.Edges if abs(e.tangentAt(0).z) > 0.99])


def rod(r, p, d, length):
    return Part.makeCylinder(r, length, V(*p), V(*d))


def _stadium(a, b, r, z0, h):
    """Vertical extrusion of a rounded slot from plan point a to b (radius r)."""
    s = Part.makeCylinder(r, h, V(a[0], a[1], z0)).fuse(Part.makeCylinder(r, h, V(b[0], b[1], z0)))
    dx, dy = b[0] - a[0], b[1] - a[1]
    L = math.hypot(dx, dy)
    if L > 1e-6:
        box = Part.makeBox(L, 2 * r, h, V(0, -r, z0))
        box.rotate(V(0, 0, 0), V(0, 0, 1), math.degrees(math.atan2(dy, dx)))
        box.translate(V(a[0], a[1], 0))
        s = s.fuse(box)
    return s


def _prism(pts, z0, h):
    w = Part.makePolygon([V(x, y, z0) for x, y in pts] + [V(pts[0][0], pts[0][1], z0)])
    return Part.Face(w).extrude(V(0, 0, h))


def _hull_solid(pts, off, z0, h):
    """Convex hull of plan points grown by `off` (rounded), extruded from z0 by h."""
    if len(pts) < 3:
        return _stadium(pts[0], pts[-1], off, z0, h)
    w = Part.makePolygon([V(x, y, z0) for x, y in pts] + [V(pts[0][0], pts[0][1], z0)])
    return Part.Face(w).makeOffset2D(off, join=0).extrude(V(0, 0, h))


# ---------------- tactile symbols (etched = incised into the cap top) ----------------
ETCH_D, ETCH_W = 0.8, 1.4      # relief height (or groove depth) and line width


def apply_symbol(shape, kind, x, y, ztop, s, flip=False):
    """Raise (emboss) or incise the symbol on a cap / surface whose top is at ztop."""
    if SYMBOL_RELIEF == "raised":
        return shape.fuse(etch(kind, x, y, ztop + ETCH_D + 0.2, s, flip, h=ETCH_D + 0.2))
    return shape.cut(etch(kind, x, y, ztop, s, flip))


def etch(kind, x, y, ztop, s, flip=False, h=None):
    """Symbol solid of size s (mm) centred at (x, y), from ztop - ETCH_D upwards.
    pause = two bars, repeat = circular arrow, minus / plus, mode = Braille cell (6 dimples) +
    pen stroke, reset = cross. Oriented for the user (top = +y); flip=True turns it 180 deg for
    the speaker on the far side."""
    z0, w = ztop - ETCH_D, ETCH_W
    h = ETCH_D + 3 if h is None else h
    k = -1.0 if flip else 1.0

    def P(u, v):
        return (x + k * u, y + k * v)

    def bar(a, b):
        return _stadium(P(*a), P(*b), w / 2, z0, h)
    if kind == "pause":
        parts = [bar((-0.17 * s, -0.3 * s), (-0.17 * s, 0.3 * s)), bar((0.17 * s, -0.3 * s), (0.17 * s, 0.3 * s))]
    elif kind == "minus":
        parts = [bar((-0.32 * s, 0), (0.32 * s, 0))]
    elif kind == "plus":
        parts = [bar((-0.32 * s, 0), (0.32 * s, 0)), bar((0, -0.32 * s), (0, 0.32 * s))]
    elif kind == "reset":
        q = 0.25 * s
        parts = [bar((-q, -q), (q, q)), bar((-q, q), (q, -q))]
    elif kind == "repeat":
        R = 0.34 * s
        ring = Part.makeCylinder(R + w / 2, h, V(x, y, z0)).cut(Part.makeCylinder(R - w / 2, h + 1, V(x, y, z0 - 0.5)))
        g0, g1 = math.radians(30), math.radians(100)            # gap in the ring
        gap = _prism([P(0, 0), P(3 * R * math.cos(g0), 3 * R * math.sin(g0)),
                      P(3 * R * math.cos(g1), 3 * R * math.sin(g1))], z0 - 0.5, h + 1)
        ring = ring.cut(gap)
        t = g0                                                    # arrowhead at the gap, pointing CCW
        u, tg = (math.cos(t), math.sin(t)), (-math.sin(t), math.cos(t))
        a = 2.0 * w
        head = _prism([P((R - a) * u[0], (R - a) * u[1]), P((R + a) * u[0], (R + a) * u[1]),
                       P(R * u[0] + 3.0 * w * tg[0], R * u[1] + 3.0 * w * tg[1])], z0, h)
        parts = [ring, head]
    elif kind == "mode":
        parts = []
        for col in (0, 1):                                        # 6-dot cell on the left
            for row in range(3):
                cx, cy = P(-0.30 * s + col * 0.2 * s, (1 - row) * 0.2 * s)
                parts.append(Part.makeCylinder(0.9, h, V(cx, cy, z0)))
        parts.append(bar((0.12 * s, -0.28 * s), (0.30 * s, 0.28 * s)))   # pen stroke on the right
    else:
        raise ValueError(kind)
    out = parts[0]
    for q in parts[1:]:
        out = out.fuse(q)
    return out


# ---------------- static parts ----------------
def shell():
    outer = rbox(BOX_W, BOX_L, PLATE_UNDER, CORNER_R, -BOX_W / 2, 0, 0)
    inner = rbox(BOX_W - 2 * WALL, BOX_L - 2 * WALL, PLATE_UNDER, CORNER_R - WALL,
                 -BOX_W / 2 + WALL, WALL, FLOOR)
    s = outer.cut(inner)
    for i in range(9):                                           # rear vents (slots)
        s = s.cut(Part.makeBox(10, 3 * WALL, 4, V(-75 + 18 * i, BOX_L - 2 * WALL, 6)))
    s = s.cut(rbox(9.5, 3 * WALL, 3.6, 1.5, 90 - 4.75, BOX_L - 2 * WALL, 6))   # USB-C (12 V PD + data)
    return s


BUTTON_CLEAR = 5.0                                       # well clearance around each cap
WRIST_PAD = (0.0, WRIST_Y - 25)


def hand_well():
    """Glove-shaped well (cut through the upper layer): per digit and for the palm, the convex
    hull over the small, medium and large hand models + GLOVE_MARGIN, smooth like a glove rather
    than a print of one hand. Plus the wrist channel, the cover cassette, the button bays and
    the path each digit takes to its button."""
    z0, h = PALM_Z, RECESS + 1
    parts = [rbox(WRIST_CHANNEL_W, WRIST_Y, h, 0, -WRIST_CHANNEL_W / 2, -1, z0),
             rbox(COVER + 4, COVER + 4, h, COVER_R + 2, -(COVER + 4) / 2, PALM_Y - (COVER + 4) / 2, z0)]
    for name, pts, off in HM.glove_outline(list(HANDS.values()), GLOVE_MARGIN):
        parts.append(_hull_solid(pts, off, z0, h))
    for hnd in HANDS.values():
        rest = hnd.rest()
        for name, b in BUTTONS.items():
            pts, r, _ = rest[b["digit"]]
            target, _ = hnd.press_target(b)
            parts.append(_stadium(pts[3], target, r[3] + WELL_CLEAR, z0, h))
            ppts, pr, _ = hnd.posed(name, BUTTONS)[0][b["digit"]]          # pressed pose
            for i in range(3):
                parts.append(_stadium(ppts[i], ppts[i + 1], max(pr[i], pr[i + 1]) + WELL_CLEAR, z0, h))
    for name, b in BUTTONS.items():                  # wheel bay also holds the + / - / || marks
        parts.append(Part.makeCylinder(b["r"] + BUTTON_CLEAR + (12 if name == "Wheel" else 0), h,
                                       V(b["x"], b["y"], z0)))
    w = parts[0].multiFuse(parts[1:])
    return w.removeSplitter()


def top_plate():
    """Two bonded layers: BASE_T floor (window, cover pocket, holes) + RECESS-thick layer with
    the glove well, strip-button pockets and the speaker display pocket."""
    p = rbox(BOX_W, BOX_L, TOP_T, CORNER_R, -BOX_W / 2, 0, PLATE_UNDER)
    p = p.makeFillet(3, [e for e in p.Edges if e.BoundBox.ZMin > BOX_H - 0.01
                         and abs(e.tangentAt(0).z) < 0.01])
    p = p.cut(hand_well())
    top_edges = [e for e in p.Edges if abs(e.BoundBox.ZMin - BOX_H) < 1e-6
                 and abs(e.BoundBox.ZMax - BOX_H) < 1e-6
                 and e.BoundBox.XMin > -BOX_W / 2 + 1 and e.BoundBox.XMax < BOX_W / 2 - 1
                 and e.BoundBox.YMax < BOX_L - 1]
    for rr in (EDGE_R, 2.0):                     # round the well's top edge (comfort)
        try:
            p = p.makeFillet(rr, top_edges)
            print("well top edge rounded R%.1f" % rr)
            break
        except Exception:
            continue
    else:
        print("note: well edge round-over not modelled (do it in fabrication: R3 router bit)")
    p = p.cut(rbox(WINDOW, WINDOW, TOP_T + 2, WINDOW_R, -WINDOW / 2, PALM_Y - WINDOW / 2,
                   PLATE_UNDER - 1))
    # cover cassette pocket in the floor layer + fingernail notch to lift it out
    depth = COVER_FRAME_T + COVER_T
    p = p.cut(rbox(COVER + 0.4, COVER + 0.4, depth + 1, COVER_R, -(COVER + 0.4) / 2,
                   PALM_Y - (COVER + 0.4) / 2, PALM_Z - depth))
    p = p.cut(Part.makeCylinder(6, depth + 1, V(0, PALM_Y - COVER / 2 - 1, PALM_Z - depth)))
    b = BUTTONS["Repeat"]                                                 # switch plunger hole
    p = p.cut(Part.makeCylinder(6.5, TOP_T + 2, V(b["x"], b["y"], PLATE_UNDER - 1)))
    # roller slot through the plate (roller crown 2.5 above the recess floor) + a pocket in the
    # plate's underside for the axle cradle, press switch and magnetic angle sensor
    p = p.cut(_stadium(_wheel_pt(-WHEEL_R - 0.8), _wheel_pt(WHEEL_R + 0.8), WHEEL_W / 2 + 0.8,
                       PLATE_UNDER - 1, TOP_T + 2))
    p = p.cut(_stadium(_wheel_pt(0, -WHEEL_W / 2 - 4), _wheel_pt(0, WHEEL_W / 2 + 6), 4.5,
                       PLATE_UNDER - 1, 1 + BASE_T - 0.8))
    p = p.cut(wheel_bezel_symbols())
    for b in list(STRIP.values()) + list(SPEAKER.values()):              # pocket + plunger hole
        p = p.cut(Part.makeCylinder(b["r"] + POCKET_CLEAR, POCKET_D + 1, V(b["x"], b["y"], BOX_H - POCKET_D)))
        p = p.cut(Part.makeCylinder(6.5, TOP_T + 2, V(b["x"], b["y"], PLATE_UNDER - 1)))
    d = DISPLAY                                                           # display pocket + cable slot
    p = p.cut(rbox(d["w"] + 1, d["l"] + 1, d["t"] + 2, 2, d["x"] - (d["w"] + 1) / 2,
                   d["y"] - (d["l"] + 1) / 2, BOX_H - d["t"] - 1))
    p = p.cut(Part.makeBox(30, 4, TOP_T + 2, V(d["x"] - 15, d["y"] - d["l"] / 2 + 3, PLATE_UNDER - 1)))
    for (x, y), _ in braille_pins():
        p = p.cut(Part.makeCylinder(0.8, TOP_T + 2, V(x, y, PLATE_UNDER - 1)))
    for i in range(4):                                                    # mic grille (faces the speaker)
        for j in range(4):
            p = p.cut(Part.makeCylinder(1.2, TOP_T + 2, V(-TS * 80 + 5 * i, 328 + 5 * j, PLATE_UNDER - 1)))
    p = p.cut(Part.makeCylinder(2.0, TOP_T + 2, V(-TS * 108, 345, PLATE_UNDER - 1)))   # LED
    p = p.cut(Part.makeCylinder(12, 1, V(WRIST_PAD[0], WRIST_PAD[1], PALM_Z - 0.4)))  # pad inlay
    return p


def cover_parts():
    """Drop-in cover cassette: a frame (inner opening = window) with the membrane bonded on top,
    flush with the well floor. The pen presses the membrane into the palm; fingers and the palm
    never touch the mechanism. Lift out by the notch to clean it or swap the material (T13)."""
    z0 = PALM_Z - COVER_FRAME_T - COVER_T
    f = rbox(COVER, COVER, COVER_FRAME_T, COVER_R, -COVER / 2, PALM_Y - COVER / 2, z0)
    f = f.cut(rbox(WINDOW, WINDOW, COVER_FRAME_T + 2, WINDOW_R, -WINDOW / 2, PALM_Y - WINDOW / 2, z0 - 1))
    m = rbox(COVER, COVER, COVER_T, COVER_R, -COVER / 2, PALM_Y - COVER / 2, PALM_Z - COVER_T)
    return f, m


def wrist_pad():
    """Flush capacitive 'hand present' pad (copper/brass disc inlaid 0.4 mm into the top)."""
    x, y = WRIST_PAD
    return Part.makeCylinder(12, 0.4, V(x, y, PALM_Z - 0.4))


BRAILLE_SHOW = {"index": (1, 2, 5), "middle": ()}         # letter H on the index cell


def braille_pins():
    """((x, y), raised) for the 6 pins of each cell, dots 1-3 left column top->bottom."""
    out = []
    for name, (cx, cy) in BRAILLE_CELLS:
        for d in range(1, 7):
            col, row = (0 if d <= 3 else 1), (d - 1) % 3
            # fingertip reads from above, as on paper: dots 1-3 on the left (-x), dot 1 furthest away
            x = cx + (-1.25 if col == 0 else 1.25)
            y = cy + (1 - row) * 2.5
            out.append(((x, y), d in BRAILLE_SHOW[name]))
    return out


def braille_parts():
    """Pop-out Braille: per cell a block of 6 latching (bistable) pin actuators under the plate.
    A short current pulse pushes a pin up 0.7 mm above the recess floor or pulls it flush; it
    stays there without power. 7 mm tall, so it fits the 20 mm box."""
    mods, pins = None, None
    for name, (cx, cy) in BRAILLE_CELLS:
        m = rbox(9, 12, 7.0, 1, cx - 4.5, cy - 6, PLATE_UNDER - 7.0)
        mods = m if mods is None else mods.fuse(m)
    for (x, y), up in braille_pins():
        top = PALM_Z + (0.7 if up else 0.0)
        c = Part.makeCylinder(0.7, top - PLATE_UNDER, V(x, y, PLATE_UNDER))
        pins = c if pins is None else pins.fuse(c)
    return mods, pins


SYMBOL_SIZE = {"Repeat": 17.0, "Mode": 16.0, "Reset": 12.0, "bezel": 7.0}


def _wheel_pt(along, side=0.0):
    """Plan point on the wheel's centre line: `along` the rolling direction, `side` along the axle."""
    return (WHEEL["x"] + WHEEL["roll"][0] * along + WHEEL_AX[0] * side,
            WHEEL["y"] + WHEEL["roll"][1] * along + WHEEL_AX[1] * side)


def wheel_parts():
    """Thumb scroll roller (thin, like a slim mouse / keyboard roller): D6 x 10 knurled roller in
    the plate, crown 2.5 mm above the recess floor. Roll AWAY from the palm = faster, IN = slower
    (a magnet in the roller end + magnetic angle sensor, detent ribs), press = pause (the roller
    cradle pivots onto a side switch). Returns (roller, sensor + switch)."""
    w = Part.makeCylinder(WHEEL_R, WHEEL_W, V(0, 0, -WHEEL_W / 2))
    for k in range(12):                                    # knurl ribs: felt as detents
        g = Part.makeBox(0.8, 0.8, WHEEL_W + 2, V(-0.4, WHEEL_R - 0.4, -WHEEL_W / 2 - 1))
        g.rotate(V(0, 0, 0), V(0, 0, 1), k * 30)
        w = w.cut(g)
    w = w.fuse(Part.makeCylinder(1.0, WHEEL_W + 6, V(0, 0, -WHEEL_W / 2 - 3)))   # axle
    w.rotate(V(0, 0, 0), V(0, 1, 0), 90)                                   # axle along +x
    w.rotate(V(0, 0, 0), V(0, 0, 1), math.degrees(math.atan2(WHEEL_AX[1], WHEEL_AX[0])))
    w.translate(V(WHEEL["x"], WHEEL["y"], PALM_Z + WHEEL_UP - WHEEL_R))
    ex, ey = _wheel_pt(0, WHEEL_W / 2 + 3.5)
    enc = Part.makeBox(5, 5, 2.5, V(ex - 2.5, ey - 2.5, PLATE_UNDER - 1.0))    # sensor + switch, under the recess floor
    return w.removeSplitter(), enc


def wheel_bezel_symbols():
    """+ (far end: roll away = faster), - (near end: roll in = slower) and || (beside the roller:
    press = pause), INCISED in the recess floor around the roller: the resting thumb lies over
    them, so raised marks would press into it."""
    s = SYMBOL_SIZE["bezel"]
    out = None
    for kind, (a, b) in (("plus", (WHEEL_R + 6.5, 0)), ("minus", (-WHEEL_R - 6.5, 0)),
                         ("pause", (0, -(WHEEL_W / 2 + 5)))):
        x, y = _wheel_pt(a, b)
        q = etch(kind, x, y, PALM_Z, s)              # incised: the thumb lies over them
        out = q if out is None else out.fuse(q)
    return out


def button_parts():
    """Every button carries a tactile symbol of its meaning (raised by default, SYMBOL_RELIEF):
    Repeat = circular arrow, Mode = Braille cell + pen stroke, Reset = x.
    Repeat: domed cap 0.5 mm above the well floor (the thumb wheel is built in wheel_parts()).
    Mode (free hand) and the speaker's Reset: flat caps in 4 mm pockets, top 1 mm below the
    surface, so the forearm or a resting hand cannot press them.
    Every cap sits on a D10 stem to a 6x6 mm low-profile tactile switch under the plate."""
    caps, switches = [], None
    for name, b in BUTTONS.items():
        if name == "Wheel":
            continue
        x, y, r = b["x"], b["y"], b["r"]
        cap = Part.makeCylinder(r, CAP_TOP - PALM_Z - 0.5, V(x, y, PALM_Z + 0.5))
        cap = cap.makeFillet(1.0, [e for e in cap.Edges if e.BoundBox.ZMin > CAP_TOP - 0.1])
        cap = cap.fuse(Part.makeCylinder(5.0, BASE_T + 0.6, V(x, y, PLATE_UNDER - 0.2)))  # stem
        cap = apply_symbol(cap, b["symbol"], x, y, CAP_TOP, SYMBOL_SIZE[name])
        caps.append((name, cap.removeSplitter()))
    for group, flip in ((STRIP, False), (SPEAKER, True)):
        for name, b in group.items():
            x, y, r = b["x"], b["y"], b["r"]
            top = BOX_H - 1.0
            cap = Part.makeCylinder(r, POCKET_D - 1.5, V(x, y, BOX_H - POCKET_D + 0.5))
            cap = cap.makeFillet(0.6, [e for e in cap.Edges if e.BoundBox.ZMin > top - 0.1])
            cap = cap.fuse(Part.makeCylinder(5.0, TOP_T - POCKET_D + 0.6, V(x, y, PLATE_UNDER - 0.2)))
            cap = apply_symbol(cap, b["symbol"], x, y, top, SYMBOL_SIZE[name], flip)
            caps.append((name, cap.removeSplitter()))
    for b in [BUTTONS["Repeat"]] + list(STRIP.values()) + list(SPEAKER.values()):
        sw = Part.makeBox(7, 7, 2.8, V(b["x"] - 3.5, b["y"] - 3.5, PLATE_UNDER - 3.2))   # 6x6 low-profile switch
        switches = sw if switches is None else switches.fuse(sw)
    return caps, switches


def display_part():
    """3.5\" IPS SPI display (480 x 320) in a pocket at the rear, glass 1 mm below the top. The
    text is drawn rotated 180 deg so it reads correctly for the speaker across the table."""
    d = DISPLAY
    m = rbox(d["w"], d["l"], d["t"], 2, d["x"] - d["w"] / 2, d["y"] - d["l"] / 2, BOX_H - d["t"] - 1)
    return m


def rails():
    """Two D5 Y-rods on supports from the base: the rails of the gantry (CoreXY)."""
    s = []
    for sx in (-1, 1):
        x = sx * RAIL_X
        s.append(rod(ROD_R, (x, ROD_Y0 - 4, Z_YROD), (0, 1, 0), ROD_Y1 - ROD_Y0 + 8))
        for y in (ROD_Y0, ROD_Y1):
            s.append(Part.makeBox(10, 8, Z_YROD + 3 - FLOOR, V(x - 5, y - 4, FLOOR)))
    return s[0].multiFuse(s[1:]).removeSplitter()


def _belt_y(x, y0, y1, z):
    return Part.makeBox(1.2, y1 - y0, BELT_W, V(x - 0.6, y0, z))


def _belt_x(x0, x1, y, z):
    return Part.makeBox(x1 - x0, 1.2, BELT_W, V(x0, y - 0.6, z))


def drives():
    """CoreXY drive, all flat. Belt A (lower layer) runs from the carriage to the gantry idlers,
    along both sides to the rear, round motor A (rear left) and the rear-right idler. Belt B
    (upper layer) runs from the carriage to the gantry idlers, along both sides to the front,
    round motor B (front right) and the front-left idler. Motor A moves the pen along x + y,
    motor B along x - y. The runs along y are static; the runs along x move with the gantry."""
    belts, metal, motors = [], [], []
    za, zb = BELT_A_Z, BELT_B_Z
    ya0 = GC_MIN - IDLER_DY                      # foremost gantry idler A tangent point
    yb1 = GC_MAX + IDLER_DY                      # rearmost gantry idler B tangent point
    belts += [_belt_y(-BELT_X, ya0, MOTOR_A[1], za), _belt_y(BELT_X, ya0, IDLER_A[1], za),
              _belt_x(MOTOR_A[0], IDLER_A[0], MOTOR_A[1] + RING_R, za)]
    belts += [_belt_y(BELT_X, MOTOR_B[1], yb1, zb), _belt_y(-BELT_X, IDLER_B[1], yb1, zb),
              _belt_x(IDLER_B[0], MOTOR_B[0], MOTOR_B[1] - RING_R, zb)]
    for (x, y), z in ((IDLER_A, za), (IDLER_B, zb)):            # corner idlers on posts
        metal.append(Part.makeCylinder(IDLER_R, BELT_W, V(x, y, z)))
        metal.append(Part.makeCylinder(1.5, z - FLOOR, V(x, y, FLOOR)))
    for (x, y), z in ((MOTOR_A, za), (MOTOR_B, zb)):            # flat gimbal motors + ring pulleys
        motors.append(Part.makeCylinder(MOTOR_R, MOTOR_H, V(x, y, FLOOR)))
        metal.append(Part.makeCylinder(RING_R + 0.6, BELT_W, V(x, y, z)))
    f = lambda L: L[0].multiFuse(L[1:]).removeSplitter() if len(L) > 1 else L[0]
    return f(belts), f(metal), f(motors)


def electronics():
    """Everything flat. Controller board: Pico + 2 BLDC drivers (DRV8313) + pen MOSFET +
    Braille pulse drivers. Phase 2: Raspberry Pi CM5 on a flat carrier (a Pi 5 is too tall)."""
    sbc = Part.makeBox(70, 46, 6, V(-TS * 60 - 35, 4, FLOOR + 0.5))        # CM5 carrier (phase 2)
    ctl = Part.makeBox(70, 46, 6, V(TS * 60 - 35, 4, FLOOR + 0.5))         # controller board
    brl = Part.makeBox(40, 24, 4, V(TS * 2.5 - 20, 300, FLOOR + 0.5))      # Braille pulse drivers
    mic = Part.makeBox(16, 16, 3, V(-TS * 80 - 2.5, 330, PLATE_UNDER - 3.2))
    return sbc, ctl, brl, mic


def forearm_pad():
    """Padded rest in front of the box, level with the well floor, so the forearm stays straight."""
    p = rbox(120, 140, PALM_Z, 20, -60, -142, 0)
    return p.makeFillet(10, [e for e in p.Edges if e.BoundBox.ZMin > PALM_Z - 0.01])


def _loft(sections):
    """Elliptical sections (y, half width, half thickness) lofted; bottom flattened at PALM_Z."""
    wires = []
    for y, hw, ht in sections:
        zc = PALM_Z + ht - HM.FLAT
        wires.append(Part.Wire(Part.Ellipse(V(hw, y, zc), V(0, y, zc + ht), V(0, y, zc)).toShape()))
    s = Part.makeLoft(wires, True, False)
    return s.cut(Part.makeBox(800, 1000, 200, V(-400, -500, PALM_Z - 200)))


def _capsules(pts, r):
    """One sphere per joint + a cone per segment (no duplicate spheres: they break booleans)."""
    parts = [Part.makeSphere(r[i], V(*pts[i])) for i in range(4)]
    for i in range(3):
        a, b = V(*pts[i]), V(*pts[i + 1])
        d = b - a
        if d.Length > 1e-6:
            parts.append(Part.makeCone(0.98 * r[i], 0.98 * r[i + 1], d.Length, a, d))  # rims inside spheres
    return parts


def hand_solid(size, pose="rest"):
    """Anatomical hand (palm loft + jointed digits) in pose 'rest' or pressing a button."""
    h = HANDS[size]
    chains, info = h.posed(pose, BUTTONS)
    parts = [_loft(h.palm_sections())]
    for pts, r, _ in chains.values():
        parts += _capsules(pts, r)
    # A compound of simple valid solids: fusing dozens of touching spheres/cones is fragile
    # in OCC, and a compound renders and collision-checks identically (see overlap()).
    return Part.makeCompound(parts), info


def arm_solid(size):
    return _loft(HANDS[size].arm_sections())


def hand_dummy():
    """Medium hand at rest + forearm (used for the main model and the gantry checks)."""
    return hand_solid("medium")[0], arm_solid("medium")


# ---------------- moving parts (built at palm offset 0,0 / pen up) ----------------
def gantry():
    """Moves in y. Two Y-blocks slide on the Y-rods (bushings); a bridge over the belt runs holds
    the twin D5 X-rods and, hanging below it, the gantry idlers of belt A (front) and belt B
    (rear). The belt runs along x (carriage to idlers) move with it. Built at gantry y = PALM_Y."""
    yc = PALM_Y
    parts = []
    for sx in (-1, 1):
        x = sx * RAIL_X
        b = Part.makeBox(15, 28, 10.5, V(x - 7.5, yc - 14, FLOOR + 0.5))
        b = b.cut(rod(BORE, (x, yc - 15, Z_YROD), (0, 1, 0), 30))
        bx0, bx1 = sorted((sx * (BELT_X - 12), sx * (RAIL_X - 7.5)))
        bridge = Part.makeBox(bx1 - bx0, 40, 4.0, V(bx0, yc - 20, 9.5))     # over the belt runs
        parts += [b, bridge]
        for dy, z in ((-IDLER_DY, BELT_A_Z), (IDLER_DY, BELT_B_Z)):
            ix = sx * (BELT_X - IDLER_R)
            parts.append(Part.makeCylinder(IDLER_R, BELT_W, V(ix, yc + dy, z)))
            parts.append(Part.makeCylinder(1.5, 9.5 - z - BELT_W, V(ix, yc + dy, z + BELT_W)))
    for dy in (-XROD_DY, XROD_DY):
        parts.append(rod(ROD_R, (-(BELT_X - 3), yc + dy, Z_XROD), (1, 0, 0), 2 * (BELT_X - 3)))
    return parts[0].multiFuse(parts[1:]).removeSplitter()


def gantry_belts():
    """Belt runs along x (moving with the gantry): A in front of the carriage, B behind it."""
    yc, xi = PALM_Y, BELT_X - IDLER_R
    a = _belt_x(-xi, xi, yc - IDLER_DY - IDLER_R, BELT_A_Z)
    b = _belt_x(-xi, xi, yc + IDLER_DY + IDLER_R, BELT_B_Z)
    return a.fuse(b)


def carriage():
    """Slides on the twin X-rods (bushings). Clamps belt A (front lug, lower layer) and belt B
    (rear lug, upper layer). Pen head: a vertical pen sleeve at the centre and a mini frame
    solenoid lying flat along x that pushes a wedge under the pen (5 mm lift). 7 mm tall."""
    cx, cy = 0.0, PALM_Y
    c = rbox(24, 20, PLATE_UNDER - 1.0 - 7.0, 2, cx - 12, cy - 10, 7.0)
    for dy in (-XROD_DY, XROD_DY):
        c = c.cut(rod(BORE, (cx - 13, cy + dy, Z_XROD), (1, 0, 0), 26))
    yA, yB = IDLER_DY + IDLER_R, IDLER_DY + IDLER_R
    lug_a = Part.makeBox(8, yA - 9, 7.0 - BELT_A_Z + 0.2, V(cx - 4, cy - yA - 1, BELT_A_Z - 0.2))
    lug_b = Part.makeBox(8, yB - 9, 7.0 - BELT_B_Z + 0.2, V(cx - 4, cy + 10, BELT_B_Z - 0.2))
    sleeve = Part.makeCylinder(3.0, 7.0 - 4.0 + 2, V(cx, cy, 4.0))
    sol = rbox(16, 7, 6.0, 1, cx + 12, cy - 3.5, 7.5)                # mini frame solenoid
    wedge = Part.makeBox(9, 5, 2.5, V(cx + 3, cy - 2.5, 4.5))       # plunger + wedge under the pen
    return c.fuse([lug_a, lug_b, sleeve, sol, wedge]).removeSplitter()


def pen():
    """Pointed pen (D3 rod, 0.5 mm radius point) on a spring in the sleeve; the spring limits
    the force on the palm. Built in the pen-up position."""
    tip = PEN_UP_TIP
    x, y = PEN_DX, PALM_Y + PEN_DY
    shaft = Part.makeCylinder(1.5, 7.0, V(x, y, tip - 10.6))
    cone = Part.makeCone(1.5, 0.5, 3.6, V(x, y, tip - 4))
    ball = Part.makeSphere(0.5, V(x, y, tip - 0.5))
    return shaft.fuse(cone).fuse(ball).removeSplitter()


# ---------------- build ----------------
doc = App.newDocument("HapticBoxV2")
COLORS = {}


def add(name, shape, col, alpha=0):
    o = doc.addObject("Part::Feature", name)
    o.Shape = shape
    COLORS[name] = (col, alpha)
    if App.GuiUp:
        o.ViewObject.ShapeColor = col
        o.ViewObject.Transparency = alpha
    return o


belts, metal, motors = drives()
sbc, ctl, brl, mic = electronics()
cover_frame, cover_membrane = cover_parts()
mods, pins = braille_parts()
caps, switches = button_parts()
wheel, encoder = wheel_parts()
caps.insert(0, ("Wheel", wheel))
switches = switches.fuse(encoder)
hand, arm = hand_dummy()
S = {
    "Shell": add("Shell", shell(), (0.10, 0.10, 0.11), 0),               # matte black
    "TopPlate": add("TopPlate", top_plate(), (0.14, 0.14, 0.15), 0),     # soft-touch black
    "ForearmPad": add("ForearmPad", forearm_pad(), (0.20, 0.20, 0.22), 0),
    "WristPad": add("WristPad", wrist_pad(), (0.95, 0.55, 0.12), 0),      # one warm accent
    "Rails": add("Rails", rails(), (0.72, 0.74, 0.76), 0),
    "Belts": add("Belts", belts, (0.12, 0.12, 0.12), 0),
    "Pulleys": add("Pulleys", metal, (0.60, 0.62, 0.64), 0),
    "Motors": add("Motors", motors, (0.18, 0.18, 0.2), 0),
    "SBC": add("SBC", sbc, (0.10, 0.55, 0.25), 0),
    "Controller": add("Controller", ctl, (0.15, 0.25, 0.65), 0),
    "BrailleDriver": add("BrailleDriver", brl, (0.55, 0.15, 0.55), 0),
    "Mic": add("Mic", mic, (0.10, 0.45, 0.20), 0),
    "SpeakerDisplay": add("SpeakerDisplay", display_part(), (0.08, 0.10, 0.14), 0),
    "CoverFrame": add("CoverFrame", cover_frame, (0.25, 0.27, 0.30), 0),
    "CoverMembrane": add("CoverMembrane", cover_membrane, (0.55, 0.75, 0.85), 50),
    "BrailleCells": add("BrailleCells", mods, (0.85, 0.85, 0.80), 0),
    "BraillePins": add("BraillePins", pins, (0.95, 0.95, 0.95), 0),
    "ButtonSwitches": add("ButtonSwitches", switches, (0.2, 0.2, 0.2), 0),
    "HandDummy": add("HandDummy", hand, (0.95, 0.78, 0.66), 40),
    "ForearmDummy": add("ForearmDummy", arm, (0.95, 0.78, 0.66), 40),
}
CAP_COL = {"Wheel": (0.86, 0.86, 0.84), "Repeat": (0.86, 0.86, 0.84), "Mode": (0.86, 0.86, 0.84),
           "Reset": (0.85, 0.16, 0.13)}     # light caps on the black top: visible to helpers; Reset red
for name, cap in caps:
    S["Button" + name] = add("Button" + name, cap, CAP_COL[name], 0)

M = {
    "Gantry": add("Gantry", gantry(), (0.29, 0.47, 0.66), 0),
    "GantryBelts": add("GantryBelts", gantry_belts(), (0.12, 0.12, 0.12), 0),
    "Carriage": add("Carriage", carriage(), (0.30, 0.30, 0.32), 0),
    "Pen": add("Pen", pen(), (0.75, 0.15, 0.15), 0),
}
PEN_STROKE = PEN_DOWN_TIP - PEN_UP_TIP


def offsets(px, py, down):
    """Machine offsets for palm coords (px, py); palm-down => mirror x (as print-on-palm)."""
    mx = -px            # writing from below a palm-down hand: mirror so letters feel upright
    cx, cy = mx - PEN_DX, py - PEN_DY                        # carriage centre
    dz = PEN_STROKE * down
    return {"Gantry": (0, cy, 0), "GantryBelts": (0, cy, 0), "Carriage": (cx, cy, 0), "Pen": (cx, cy, dz)}


def set_pose(px, py, down):
    for k, (dx, dy, dz) in offsets(px, py, down).items():
        M[k].Placement = Placement(V(dx, dy, dz), Rotation())


set_pose(0, 0, 0)
doc.recompute()


# ---------------- checks ----------------
def overlap(a, b):
    """Intersection volume; compounds (the hand) are checked solid by solid."""
    if not a.BoundBox.intersect(b.BoundBox):
        return 0.0
    if a.ShapeType == "Compound":
        return sum(overlap(x, b) for x in a.Solids)
    if b.ShapeType == "Compound":
        return sum(overlap(a, x) for x in b.Solids)
    return a.common(b).Volume


INTENDED = {("Belts", "Gantry"), ("Pulleys", "GantryBelts"),  # belts run onto the gantry idlers
            ("Belts", "GantryBelts"), ("GantryBelts", "Gantry"), ("GantryBelts", "Carriage"),
            ("Carriage", "GantryBelts"), ("Gantry", "GantryBelts"), ("Gantry", "Belts"),
            ("Rails", "Gantry"),                           # Y-rods run through the Y-block bushings
            ("Gantry", "Carriage"), ("Carriage", "Gantry"),  # X-rods run through the carriage bushings
            ("CoverMembrane", "Pen"),
            ("Pen", "Carriage"),                            # pen runs inside its sleeve
            ("Pen", "CoverMembrane")}                       # pen pushes the membrane into the palm


def run_checks():
    ok = True
    hand_s = S["HandDummy"].Shape

    def rep(name, v, tol=1e-3):
        nonlocal ok
        bad = v > tol
        ok &= not bad
        print("  %-44s %10.4f mm^3  %s" % (name, v, "FAIL" if bad else "ok"))

    print("Hand on the top (static):")
    for k in S:
        if k in ("HandDummy", "ForearmDummy", "BraillePins"):
            continue
        v = overlap(hand_s, S[k].Shape) + overlap(S["ForearmDummy"].Shape, S[k].Shape)
        if v > 1e-3 or k in ("TopPlate", "ForearmPad"):
            rep("hand/forearm vs %s" % k, v)
    print("  raised Braille pins pressing into fingertips: %.1f mm (intended)" % 0.7)
    print("Static parts vs each other:")
    names = [k for k in S if k not in ("HandDummy", "ForearmDummy")]
    worst = 0.0
    for i, a in enumerate(names):
        for b in names[i + 1:]:
            if {a, b} in ({"BrailleCells", "BraillePins"}, {"TopPlate", "BraillePins"},
                          {"Pulleys", "Motors"}, {"Pulleys", "Belts"}, {"Belts", "Motors"},
                          {"ButtonWheel", "ButtonSwitches"}, {"ButtonWheel", "TopPlate"}):  # roller axle in its cradle
                continue
            v = overlap(S[a].Shape, S[b].Shape)
            if v > 1e-3:
                rep("%s vs %s" % (a, b), v)
            worst = max(worst, v)
    print("  worst static overlap %.4f mm^3" % worst)

    g = [-pw.WORKSPACE / 2 + pw.WORKSPACE * i / 4 for i in range(5)]
    print("Gantry sweep: %d x %d poses over the %.0f mm workspace, pen up and down" %
          (len(g), len(g), pw.WORKSPACE))
    res = {}
    stat = [k for k in S if k not in ("HandDummy", "ForearmDummy")]
    for down in (0, 1):
        for px in g:
            for py in g:
                set_pose(px, py, down)
                for m in M:
                    ms = M[m].Shape
                    for k in stat:
                        if (k, m) in INTENDED:
                            continue
                        res[(m, k)] = max(res.get((m, k), 0), overlap(ms, S[k].Shape))
                    if m != "Pen":
                        res[(m, "hand")] = max(res.get((m, "hand"), 0), overlap(ms, hand_s))
                mm = list(M)
                for i, a in enumerate(mm):
                    for b in mm[i + 1:]:
                        if (a, b) in INTENDED or (b, a) in INTENDED:
                            continue
                        res[(a, b)] = max(res.get((a, b), 0), overlap(M[a].Shape, M[b].Shape))
                tip = M["Pen"].Shape.BoundBox.ZMax
                key = "pen tip above recess floor, %s" % ("down" if down else "up")
                res[key] = tip - PALM_Z
    for k, v in sorted(res.items(), key=lambda kv: str(kv[0])):
        if isinstance(k, str):
            print("  %-44s %10.2f mm" % (k, v))
        elif v > 1e-3 or k in (("Pen", "TopPlate"), ("Carriage", "TopPlate"), ("Gantry", "TopPlate"),
                               ("Carriage", "hand")):
            rep("%s vs %s" % k, v)
    print("  (%d moving pairs checked)" % len([k for k in res if not isinstance(k, str)]))
    set_pose(0, 0, 0)
    print("Box: %.0f W x %.0f L x %.0f H mm; glove recess %.1f mm deep, palm at z=%.1f; forearm pad %.1f mm high" %
          (BOX_W, BOX_L, BOX_H, RECESS, PALM_Z, PALM_Z))
    for name, b in BUTTONS.items():
        print("  control %-6s at (%6.1f, %6.1f), %s '%s', used by the %s" % (
            name, b["x"], b["y"], SYMBOL_RELIEF, b["symbol"], b["digit"]))
    for grp, who in ((STRIP, "free hand"), (SPEAKER, "speaker")):
        for name, b in grp.items():
            print("  control %-6s at (%6.1f, %6.1f), cap D%.0f, %s '%s', %s" % (
                name, b["x"], b["y"], 2 * b["r"], SYMBOL_RELIEF, b["symbol"], who))
    print("Cover: %.0f mm cassette, %.1f mm membrane flush with the well floor; pen retracted %.1f mm "
          "below it" % (COVER, COVER_T, PALM_Z - PEN_UP_TIP))
    print("Pen stroke %.1f mm (tip %.1f below plate underside -> %.1f into the palm)" %
          (PEN_STROKE, PEN_UP_GAP, PEN_PRESS))
    print("CLEARANCES OK" if ok else "INTERFERENCE DETECTED")
    return ok


def hand_checks():
    """Fit of every hand size in the well, and reach of every button without moving the hand."""
    ok = True
    keys = ["TopPlate", "WristPad", "ForearmPad", "Shell", "CoverFrame", "CoverMembrane"] + \
        ["Button" + n for n in list(BUTTONS) + list(STRIP) + list(SPEAKER)]
    print("Hand fit and reach (palm down, wrist crease at y = %.0f):" % WRIST_Y)
    print("  %-7s %-7s %-7s %7s %10s %12s  %s" % ("size", "pose", "digit", "swing", "short mm",
                                                   "clash mm^3", "result"))
    for size, h in HANDS.items():
        arm = arm_solid(size)
        clash = sum(overlap(arm, S[k].Shape) for k in ("TopPlate", "ForearmPad", "Shell"))
        print("  %-7s %-7s %-7s %7s %10s %12.3f  %s" % (size, "forearm", "", "", "", clash,
                                                       "ok" if clash < 1e-3 else "FAIL"))
        ok &= clash < 1e-3
        for pose in ["rest"] + list(BUTTONS):
            hs, info = hand_solid(size, pose)
            clash, pressed, hit = 0.0, None, []
            for k in keys:
                v = overlap(hs, S[k].Shape)
                if pose != "rest" and k == "Button" + pose:
                    pressed = v
                    continue
                clash += v
                if v > 1e-3:
                    hit.append("%s %.2f" % (k, v))
            digit, swing, short = info if info else ("", 0.0, 0.0)
            good = clash < 1e-3 and short <= 0.5 and (pressed is None or pressed > 0)
            ok &= good
            print("  %-7s %-7s %-7s %6.0f° %10.1f %12.3f  %s" % (
                size, pose, digit, swing, short, clash,
                ("ok" if good else "FAIL") + ("" if pressed is None else
                                              ("  (presses)" if pressed > 0 else "  (misses)")) +
                ("  touches: " + ", ".join(hit) if hit else "")))
        pc = h.palm_centre
        print("  %-7s palm centre (%.0f, %.0f): %.1f mm from the writing centre; index/middle pad "
              "to Braille cell: %.1f / %.1f mm" % (
                  size, pc[0], pc[1], math.hypot(pc[0], pc[1] - PALM_Y),
                  math.dist(_pad(h, "index"), BRAILLE_CELLS[0][1]),
                  math.dist(_pad(h, "middle"), BRAILLE_CELLS[1][1])))
    print("HAND FIT OK" if ok else "HAND FIT PROBLEMS")
    return ok


def dump(path):
    """Meshes for render_views.py: static parts + moving parts at the base pose."""
    import MeshPart

    def mesh(shape, tol=0.4):
        m = MeshPart.meshFromShape(Shape=shape, LinearDeflection=max(tol, 0.25),
                                   AngularDeflection=0.4, Relative=False)
        return {"v": [[round(p.x, 3), round(p.y, 3), round(p.z, 3)] for p in m.Points],
                "f": [list(f.PointIndices) for f in m.Facets]}
    for o in M.values():               # moving parts exported un-placed; the renderer applies
        o.Placement = Placement()      # offsets(px, py, down) itself
    data = {"static": {k: mesh(o.Shape) for k, o in S.items()},
            "moving": {k: mesh(o.Shape) for k, o in M.items()},
            "colors": {k: [list(c), a / 100.0] for k, (c, a) in COLORS.items()},
            "params": dict(PEN_DX=PEN_DX, PEN_DY=PEN_DY, PALM_Y=PALM_Y, PALM_Z=PALM_Z, BOX_H=BOX_H, BOX_W=BOX_W, BOX_L=BOX_L,
                           PEN_STROKE=PEN_STROKE, WINDOW=WINDOW, PLATE_UNDER=PLATE_UNDER,
                           TS=TS, WRIST_Y=WRIST_Y,
                           buttons={k: [b["x"], b["y"]] for k, b in
                                    list(BUTTONS.items()) + list(STRIP.items()) + list(SPEAKER.items())},
                           strip=STRIP, speaker=SPEAKER, display=DISPLAY, symbol_size=SYMBOL_SIZE,
                           COVER=COVER, COVER_T=COVER_T, Z_YROD=Z_YROD, Z_XROD=Z_XROD,
                           BELT_A_Z=BELT_A_Z, BELT_B_Z=BELT_B_Z, BELT_W=BELT_W, RAIL_X=RAIL_X,
                           BELT_X=BELT_X, XROD_DY=XROD_DY, IDLER_DY=IDLER_DY,
                           PEN_UP_TIP=PEN_UP_TIP, CAP_TOP=CAP_TOP, FLOOR=FLOOR,
                           MOTOR_A=MOTOR_A, MOTOR_B=MOTOR_B, MOTOR_R=MOTOR_R, MOTOR_H=MOTOR_H,
                           WHEEL_R=WHEEL_R,
                           button_r={k: b.get("r", b.get("w", 0) / 2) for k, b in BUTTONS.items()},
                           button_spec=BUTTONS, wrist_pad=WRIST_PAD,
                           RECESS=RECESS, BASE_T=BASE_T, TOP_T=TOP_T,
                           braille=[list(c) for _, c in BRAILLE_CELLS],
                           hand_sizes={k: list(v) for k, v in HM.SIZES.items()},
                           mirror_x=True)}
    # hand + forearm for every size and pose (rest, pressing each button)
    data["hands"] = {}
    for size in HANDS:
        d = {"arm": mesh(arm_solid(size), 0.8)}
        for pose in ["rest"] + list(BUTTONS):
            d[pose] = mesh(hand_solid(size, pose)[0], 0.6)
        data["hands"][size] = d
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f)
    set_pose(0, 0, 0)
    print("Mesh dump", path)


if App.GuiUp:
    import FreeCADGui as Gui
    from PySide import QtCore

    Gui.activeDocument().activeView().viewIsometric()
    Gui.SendMsgToActiveView("ViewFit")
    t, x, y, z, _ = pw.build_path(TEXT)
    old = getattr(App, "_writer_timer", None)
    if old is not None:
        old.stop()
    t0 = time.monotonic()

    def _tick():
        try:
            i = int(((time.monotonic() - t0) / pw.DT) % len(t))
            set_pose(x[i], y[i], 1.0 - z[i] / pw.PEN_LIFT)
            Gui.updateGui()
        except Exception:
            App._writer_timer.stop()

    timer = QtCore.QTimer()
    timer.timeout.connect(_tick)
    timer.start(20)
    App._writer_timer = timer

    def stop_writer():
        App._writer_timer.stop()

    import __main__
    __main__.stop_writer = stop_writer
    App.Console.PrintMessage("Writing %r from below (%.1f s loop). stop_writer() to stop.\n"
                             % (TEXT, t[-1]))
else:
    run_checks()
    hand_checks()
    doc.saveAs(os.path.join(HERE, "haptic_box_v2.FCStd"))
    Part.export([o for o in doc.Objects if "Dummy" not in o.Name],
                os.path.join(HERE, "haptic_box_v2.step"))
    print("Saved haptic_box_v2.FCStd and haptic_box_v2.step")
    if os.environ.get("HAPTIC_DUMP"):
        dump(os.environ["HAPTIC_DUMP"])
